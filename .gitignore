.vscode/
.idea/
*.swp
*.swo

# Test output
test_results.txt
full_test_results.txt

# OS
Thumbs.db
.DS_Store

# TTS cache (generated at runtime)
storage/tts_cache/

# On-agent account-wipe archive (screenshots + reasons)
wipe_history/

# Cached Google account credentials (GV_SAVE_CREDENTIALS=1) — never commit
storage/gv_accounts.json

# Archives / local packaging
*.7z

# Runtime state & per-server data (never version, never wipe on update)
logs/
profiles/
.tmp_uc_probe*/
chrome-win64*/
storage/prompts.json
storage/script_templates.json
storage/bot_settings.json
storage/.update_applied

# SIP reverse-engineering captures (contain live cookies/credentials)
captures/
tests-requests/
