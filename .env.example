# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Optional: if api.telegram.org times out on Ubuntu (IPv6/DPI).
# TELEGRAM_FORCE_IPV4=1 is the Linux default. Set 0 to allow IPv6.
# TELEGRAM_FORCE_IPV4=1
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_API_BASE=http://127.0.0.1:8081/bot

# Deepgram
DEEPGRAM_API_KEY=your_deepgram_key_here
# Optional Voice Agent model overrides
DG_LISTEN_MODEL=nova-3
DG_LISTEN_VERSION=
DG_THINK_PROVIDER=open_ai
DG_THINK_MODEL=gpt-4o-mini
DG_THINK_TEMPERATURE=
DG_THINK_ENDPOINT_URL=
DG_THINK_ENDPOINT_HEADERS=
# Example for Google (requires endpoint + headers):
# DG_THINK_PROVIDER=google
# DG_THINK_MODEL=gemini-2.5-flash
# DG_THINK_ENDPOINT_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:streamGenerateContent?alt=sse
# DG_THINK_ENDPOINT_HEADERS={"x-goog-api-key":"YOUR_GEMINI_KEY"}
DG_SPEAK_MODEL=aura-2-thalia-en

# Google Voice Credentials
GV_EMAIL=your_google_email
GV_PASSWORD=your_google_password
GV_PHONE=+1XXXXXXXXXX
GV_MAX_WORKERS=8
# 1 = headless (default). Set to 0 to SEE the Chrome windows while debugging.
GV_HEADLESS=1
GV_STARTUP_TIMEOUT_SEC=120
GV_WORKER_ACQUIRE_TIMEOUT_SEC=60
GV_NUMBER_FETCH_RETRIES=8
GV_INIT_RETRY_COUNT=3
GV_INIT_RETRY_DELAY_SEC=30
# Parallel GV logins after Chrome spawn (2 is safer on 4–6 vCPU with 8 workers)
GV_INIT_LOGIN_CONCURRENCY=2
# Chrome low-end flags for multi-worker on weak CPUs (1=on)
GV_LOW_END_MODE=1

# Audio CPU tuning (8 workers on weak hosts)
# soxr: QQ < LQ < MQ < HQ < VHQ — LQ is default for phone audio
AUDIO_RESAMPLE_QUALITY=LQ
AUDIO_CAPTURE_BLOCKSIZE=4096
AUDIO_CAPTURE_POLL_SEC=0.012
AUDIO_CAPTURE_SEND_INTERVAL_SEC=0.080

# Max numbers per bulk .txt upload (default 500)
MAX_BATCH_SIZE=2000

# Anti-hang / self-heal (agents)
GV_PAGE_LOAD_TIMEOUT_SEC=25
GV_SCRIPT_TIMEOUT_SEC=15
GV_RECOVERY_TIMEOUT_SEC=20
GV_HANGUP_TIMEOUT_SEC=15
GV_RELEASE_TIMEOUT_SEC=25
GV_WORKER_STUCK_SEC=240
P1_CALL_HARD_TIMEOUT_SEC=210
AGENT_WATCHDOG_SEC=20

# ── Chrome memory guard (fixes "out of memory" worker crashes) ──
# V8 heap cap per worker tab. Lower it only if the host is very tight on RAM:
# too low and the Google Voice renderer crashes with "out of memory" mid-run.
GV_JS_HEAP_MB=512
# Reload the dialer tab every N calls (drops the SPA's accumulated DOM). 0=off
GV_RECYCLE_AFTER_CALLS=25
# Respawn Chrome every N calls. 0=off
GV_RESTART_AFTER_CALLS=200
# Reload once the V8 heap reaches this % of its own limit
GV_JS_HEAP_SOFT_PCT=70
# Per-worker Chrome RSS budget: soft => reload tab, hard => respawn browser
GV_WORKER_RSS_SOFT_MB=900
GV_WORKER_RSS_HARD_MB=1400
# Postpone proactive respawns while host free RAM is under this (MB)
GV_HOST_FREE_MB_MIN=700
# Give up on a worker after this many failed browser restarts
GV_MAX_RESTARTS=5
# Parallel browser restarts (keep at 1 on weak boxes)
GV_REVIVE_CONCURRENCY=1

# ── Automatic Google sign-in (/accounts + /login on the controller) ──
# A profile with no live Google session signs itself in once the operator has
# sent that account's password. 0 = only report, never type anything.
GV_AUTOLOGIN=1
# Wall clock for one sign-in (landing page -> form -> dialer)
GV_LOGIN_TIMEOUT_SEC=120
# Parallel sign-ins per agent. Real concurrency (one browser each) — keep it
# low: many accounts authenticating at once from one IP invites 2FA prompts.
GV_LOGIN_CONCURRENCY=2
# Give up on a profile after this many attempts. A rejected password or a 2FA
# prompt is never retried, to avoid locking the account.
GV_MAX_LOGIN_ATTEMPTS=3
# Cache credentials on the agent so a restart signs in without the operator.
# WARNING: writes Google passwords to disk in plain text (storage/gv_accounts.json).
GV_SAVE_CREDENTIALS=0
# GV_ACCOUNTS_FILE=/opt/ai-caller/storage/gv_accounts.json

# Logging
LOG_LEVEL=INFO

# On-agent wipe archive (screenshots + reasons before an account is vacated).
# Files stay on the agent under wipe_history/. Old shots are deleted.
# GV_WIPE_HISTORY_KEEP=12
# GV_WIPE_HISTORY_DIR=

# VAC cable recording (capture = remote party, playback = our TTS).
# Non-P1 calls delete WAVs when the call ends. P1 keeps them until Telegram upload.
# GV_CALL_RECORD=1
# GV_P1_SEND_RECORDINGS=1
# GV_P1_RECORD_MAX_MB=3
# GV_CALL_RECORD_DIR=

# ── Distributed mode (Phase 1) ──
# standalone : single box, current behaviour (default — Redis not needed)
# controller : runs Telegram bot, aggregates agents over Redis
# agent      : runs local PhonePool on an RDP server, no Telegram
NODE_ROLE=standalone
# Required when NODE_ROLE=controller or agent. Use rediss:// for TLS.
# Example: rediss://:STRONGPASSWORD@controller-host:6380/0
REDIS_URL=
# Optional stable agent id (defaults to hostname)
AGENT_ID=
AGENT_HEARTBEAT_SEC=10
AGENT_TTL_SEC=35
